{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start local website",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "http.server",
        "8000",
        "--bind",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Start website (Dev Container)",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "8000",
        "--bind",
        "0.0.0.0"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
