{
  "name": "MAGIC Website",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8000,
    5500
  ],
  "portsAttributes": {
    "8000": {
      "label": "Local website",
      "onAutoForward": "notify"
    },
    "5500": {
      "label": "Live Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "vscode.html-language-features",
        "ritwickdey.LiveServer"
      ]
    }
  },
  "postCreateCommand": "python --version"
}
